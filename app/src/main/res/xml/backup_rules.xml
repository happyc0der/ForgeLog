<?xml version="1.0" encoding="utf-8"?>
<!--
    API 26 to 30, where auto-backup has no separate device-transfer route: everything here goes to
    Google's cloud, so nothing is included.

    An empty <full-backup-content> with no <include> would still back everything up; the explicit
    excludes are what actually opt out. API 31 and up is governed by
    data_extraction_rules.xml, which does allow a direct phone-to-phone transfer.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
